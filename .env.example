NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/nodejs_app_claude

CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app (0 when exposed directly)
TRUST_PROXY_HOPS=0

LOG_LEVEL=debug

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Set to false only if your browser refuses Secure cookies on http://localhost
COOKIE_SECURE=true